# Lo que NO entra a la imagen de Docker (el contexto de build es la raíz del repo).

# Secretos y configuración local: en Render van como variables de entorno, nunca dentro de la imagen.
**/appsettings.Development.json
**/appsettings.Local.json
**/secrets.json
**/*.env
**/.env*

# La base de datos no va en la imagen (los scripts SQL se corren en Supabase)
db/

# Resultados de compilación (se generan dentro de la imagen)
**/bin/
**/obj/

# Herramientas, historial y archivos que no hacen falta
.git/
.gitignore
.vs/
.vscode/
.hallmark/
.impeccable/
.opencode/
.antigravity/
**/Properties/launchSettings.json
**/*.http
*.md
backend/Dockerfile
.dockerignore

# Documentacion (capturas del README)
docs/
